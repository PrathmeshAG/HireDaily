# ============================================================
# HireDaily Backend — Environment Variables
# ============================================================
# Copy this file to `backend/.env` and fill in real values LOCALLY.
# NEVER commit real secrets. This file contains NO real secrets.

# ---- Firebase Admin (Phase 4) ----
# Realtime Database URL for the Firebase project.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Firebase project id.
FIREBASE_PROJECT_ID=your-project-id
# Firebase service-account client email.
FIREBASE_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Firebase service-account private key (PEM, with literal \n escapes).
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----\n

# ---- Webhook verification (Phase 4) ----
# Shared secret used to verify Meta webhook subscription (hub.challenge) and
# to verify inbound webhook signatures (HMAC-SHA256).
WEBHOOK_VERIFY_TOKEN=replace-me

# ---- Public app URL (Phase 5 Checkpoint 2) ----
# Scheme + host used to build the public Hire Daily job detail URL:
#   ${PUBLIC_APP_URL}/jobs/{jobId}
PUBLIC_APP_URL=https://hire-daily.vercel.app

# ---- Instagram / Meta (Phase 5 Checkpoint 3) ----
# Meta Graph API access token for the Instagram Business account that owns
# the posts. REQUIRED to send REAL public comment replies. NEVER log or
# expose this. Leave empty to keep real sends disabled.
META_ACCESS_TOKEN=
# Instagram Login: graph.instagram.com. Facebook Login for Business: graph.facebook.com.
META_API_HOST=graph.instagram.com

# Development/mock mode. When "true", the comment-reply service builds +
# validates the request but NEVER calls the real Meta API and returns a
# simulated success (logged as a dry run). Production must explicitly set
# this to "true" to enable dry-run; it is never enabled implicitly.
META_DRY_RUN=true

# ---- Server ----
# HTTP port the backend listens on.
PORT=8787

# Optional but recommended: exact @username of the connected Hire Daily Instagram account.
INSTAGRAM_USERNAME=hire_daily
